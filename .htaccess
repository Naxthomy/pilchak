DirectoryIndex index.php

# Bloquea el acceso web a .env, a los .sql (schema y migraciones) y a README.md (Apache 2.4, con fallback a 2.2).
# Ojo: esto NO aplica con `php -S` ni con Nginx; en producción conviene
# guardar el .env fuera del directorio público.
<FilesMatch "^(\.env.*|.*\.sql|README\.md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# Borrador viejo de la API (PruebaPostsAnterior.php): usa otra clave de sesión y expone PUT/DELETE
# sin verificar que el post sea del usuario. No se borra, pero queda inaccesible por web.
<FilesMatch "^PruebaPostsAnterior\.php$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
